<!--
     Single row of transport and secondary controls, used when the screen is at least 600 dp wide
     (landscape phones and tablets). Portrait phones use layout/playback_controls.xml instead.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Repeat this recording from the start when it ends. Off by default. Shared by the audio and transcript tabs -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/loopButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:minWidth="48dp"
                android:padding="0dp"
                app:icon="@drawable/ic_repeat"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/rewindButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/playback_skip_back"
                    app:backgroundTint="?attr/colorSecondaryContainer"
                    app:elevation="0dp"
                    app:fabCustomSize="64dp"
                    app:maxImageSize="32dp"
                    app:srcCompat="@drawable/ic_replay"
                    app:tint="?attr/colorOnSecondaryContainer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="10"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/playPauseImageView"
            android:tag="controls-single-row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/play"
                app:backgroundTint="?attr/colorTertiary"
                app:shapeAppearanceOverlay="@style/PlayCircleShapeOverlay"
                app:elevation="0dp"
                app:fabCustomSize="88dp"
                app:maxImageSize="44dp"
                app:srcCompat="@drawable/ic_play_arrow"
                app:tint="?attr/colorOnTertiary" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/forwardButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/playback_skip_forward"
                    app:backgroundTint="?attr/colorSecondaryContainer"
                    app:elevation="0dp"
                    app:fabCustomSize="64dp"
                    app:maxImageSize="32dp"
                    app:srcCompat="@drawable/ic_forward"
                    app:tint="?attr/colorOnSecondaryContainer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="10"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <!-- Sized by its label, never squeezed: the label must stay on one line -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/speedButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:singleLine="true"
                android:text="1x" />

            <!-- Keep the screen on while reading along. Off by default. Icon-only, on the right to balance the loop button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/keepAwakeButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/playback_keep_screen_on"
                android:minWidth="48dp"
                android:padding="0dp"
                app:icon="@drawable/ic_keep_screen_on"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
        </LinearLayout>
</merge>
